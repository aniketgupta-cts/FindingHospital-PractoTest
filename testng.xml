<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Practo Hackathon Suite" parallel="tests" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.cognizant.project.listeners.TestListener"/>
    </listeners>

    <!-- ══════════════════════════════════════════════════════════════════
         CHROME RUNS
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Cucumber BDD flows on Chrome -->
    <test name="Chrome - Cucumber BDD Tests">
        <parameter name="browser" value="Chrome"/>
        <classes>
            <class name="com.cognizant.project.runner.TestRunner"/>
        </classes>
    </test>

    <!-- TestNG direct tests on Chrome -->
    <test name="Chrome - TestNG Tests">
        <parameter name="browser" value="Chrome"/>
        <classes>
            <class name="com.cognizant.project.tests.PractoTest"/>
        </classes>
    </test>

    <!-- ══════════════════════════════════════════════════════════════════
         EDGE RUNS
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Cucumber BDD flows on Edge -->
    <test name="Edge - Cucumber BDD Tests">
        <parameter name="browser" value="Edge"/>
        <classes>
            <class name="com.cognizant.project.runner.TestRunner"/>
        </classes>
    </test>

    <!-- TestNG direct tests on Edge -->
    <test name="Edge - TestNG Tests">
        <parameter name="browser" value="Edge"/>
        <classes>
            <class name="com.cognizant.project.tests.PractoTest"/>
        </classes>
    </test>

</suite>